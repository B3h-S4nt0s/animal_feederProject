<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link type="text/css" rel="stylesheet" href="public/css/dashboard.css">
    <title>projeto IOT - Animal Feeder</title>
</head>

<body>
    <header>
        <div>
            <div class="divideCenter">
                <div class="logo">
                    <a href="/index"><img src="public/imgs/cats-dogs.png" alt="logo-png" srcset="public/imgs/cats-dogs.png"></a>
                </div>
            </div>
            <div class="divideCenter">
                <ul>
                    <li>Home</li>
                    <li class="active">Dashboard</li>
                    <li>Profile</li>
                </ul>
            </div>
        </div>
    </header>
    <main>
        <section class="entradas">
            <section class="values">
                <div class="pesoAnimal">
                    <label>Peso Animal: </label>
                    <input type="number" name="peso" placeholder="">
                    <div>g</div>
                </div>
                <div class="alturaAnimal">
                    <label>Altura Animal: </label>
                    <input type="number" name="altura" placeholder="">
                    <div>cm</div>
                </div>
            </section>
            <section class="values">
                <div id="qtdRacao">
                    <select>
                        <option value="gato">gato</option>
                        <option value="cachorro">cachorro</option>
                    </select>
                </div>
            </section>
            <div class="imcAnimal">
                
            </div>
        </section>
        <section class="grade">
            <h3>
                Quadro de Alimentação
            </h3>
            <div class="controlCenter">
                <!-- dias da semana -->
                <div class="horary">
                    <ul>horário</ul>
                </div>
                <!-- Segunda -->
                <div class="monday">
                    segunda
                </div>
                <!-- Terçaa -->
                <div class="tuesday">
                    terça
                </div>
                <!-- Quarta -->
                <div class="wednesday">
                    quarta
                </div>
                <!-- Quinta -->
                <div class="thursday">
                    quinta
                </div>
                <!-- Sexta -->
                <div class="friday">
                    sexta
                </div>
                <!-- Sábado -->
                <div class="saturday">
                    sábado
                </div>
                <!-- Domingo -->
                <div class="sunday">
                    domingo
                </div>
            </div>
        </section>
    </main>
    <script src="public/js/dashboard.js"></script>
</body>
</html>